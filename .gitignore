node_modules/
backend/uploads/*
backend/converted/*
!backend/uploads/.gitkeep
!backend/converted/.gitkeep
.env
.DS_Store
*.log
frontend/assets/profile-pictures/*
frontend/assets/chat-media/*
frontend/assets/feed-media/*
frontend/assets/event-media/*
!frontend/assets/profile-pictures/.gitkeep
!frontend/assets/chat-media/.gitkeep
!frontend/assets/feed-media/.gitkeep
!frontend/assets/event-media/.gitkeep

# Binários do laboratório v86 (grandes; baixados manualmente)
frontend/assets/v86/*
!frontend/assets/v86/README.txt

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# tfvars reais podem conter segredos (ex.: resend_api_key) — não versionar.
# O .example e o .terraform.lock.hcl ficam versionados.
infra/terraform.tfvars
infra/**/terraform.tfvars
*.auto.tfvars
override.tf
override.tf.json
