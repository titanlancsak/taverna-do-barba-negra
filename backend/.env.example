# === Banco de dados (PostgreSQL / Amazon RDS) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taverna
DB_USER=taverna
DB_PASSWORD=troque-isto
# Em RDS use DB_SSL=true. Localmente (Postgres sem TLS) deixe em branco.
DB_SSL=

# === Autenticação ===
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# === E-mail transacional (Resend) ===
RESEND_API_KEY=
EMAIL_DOMAIN=

# === Servidor ===
PORT=3000

# Origens permitidas para o Socket.io (CORS), separadas por vírgula.
# Produção AWS, ex.: https://app.blackbeardtavern.me
CLIENT_ORIGIN=http://localhost:8080

# === Escala horizontal (opcional) ===
# URL do Redis para o adapter do Socket.io. Em branco = instância única (dev).
# Em produção, ex.: redis://meu-endpoint.cache.amazonaws.com:6379
REDIS_URL=

# Raiz da mídia enviada por usuários. Em branco = frontend/assets (local/VM).
# Em container (Fargate) aponte para o volume EFS, ex.: /data/media
MEDIA_ROOT=
